# TEMPLATE ONLY. Copy to .env and fill in locally. Never commit .env. Never paste real values into chat.
# .env is git-ignored. `revos doctor` reports which variables are set without printing their values.

# --- Mode ---
REVOS_ENV=demo                      # demo | dev
AUTONOMY_MODE=autonomous            # autonomous (auto + veto window) | approval (brief-compliant: humans approve)
VETO_WINDOW_SECONDS=60
KILL_SWITCH_FILE=var/KILL_SWITCH

# --- Ports (other containers already use 8000 and 8012 on this machine) ---
APP_PORT=8100
POSTGRES_PORT=5434
DATABASE_URL=postgresql://revos:revos@localhost:5434/revos

# --- Anthropic (the only paid service). Leave empty to run on the offline fake LLM. ---
ANTHROPIC_API_KEY=
LLM_MODE=fake                       # fake | live
LLM_MAX_SPEND_USD=3.00
MODEL_DRAFTING=claude-sonnet-5-5
MODEL_CLASSIFY=claude-haiku-5-5

# --- HubSpot (EU developer account; service key) ---
HUBSPOT_TOKEN=
HUBSPOT_BASE_URL=https://api.hubapi.com

# --- Slack ---
SLACK_BOT_TOKEN=                    # starts with xoxb-
SLACK_SIGNING_SECRET=
SLACK_CHANNEL=#revops

# --- Gmail (SMTP send / IMAP read) ---
GMAIL_ADDRESS=                      # the sender inbox
GMAIL_APP_PASSWORD=                 # 16-character app password
PROSPECT_TEST_EMAIL=                # a separate inbox that plays the customer; the ONLY allowed recipient besides the sender
POSTAL_ADDRESS=                     # shown in every email footer

# --- Fireflies ---
FIREFLIES_API_KEY=

# --- Dropbox Sign (keep test mode) ---
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_TEST_MODE=true

# --- Research (optional; empty = mock research) ---
TAVILY_API_KEY=

# --- Public URL for inbound webhooks (Slack, Fireflies, Dropbox Sign), from cloudflared ---
PUBLIC_BASE_URL=

# Send window. enforce (default) holds sends outside the pack's weekday hours in the recipient's timezone.
# demo_bypass skips ONLY that check, ONLY when REVOS_ENV=demo (otherwise the app refuses to start), and
# writes a send_window.bypassed audit row for every send it lets through. Allowlist, caps, suppression,
# the kill switch and hard blocks are never affected.
SEND_WINDOW_MODE=enforce            # enforce | demo_bypass
